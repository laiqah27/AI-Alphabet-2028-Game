    text_rect2 = scoreText2.get_rect(center=scoreButton2.center)
    screen.blit(scoreText1, text_rect1)
    screen.blit(scoreText2, text_rect2)

def calculateScore(newTile, score):
    if newTile != ' ':
        score += 10 #score should add 10 points for any successful move
        scoreIncrement = 2 ** (ord(newTile) - ord('A'))  #score increments should increase by a power of 2 for every new tile
    else:
        scoreIncrement = 0
    return score + scoreIncrement #returns updated score5

def isgameWon(board):
    for row in board:
        for cell in row:
            if cell != None and cell.letter == 'Z':
                return True
            else:
                return False

def isgameOver(board):
    #check for empty cells
    for row in board:
        for cell in row:
            if cell is None:  #if there's an empty cell, game is not over
                    return False

    #check possible merges 
    for row in range(4):
            for col in range(4):
                if board[row][col] is None:
                    return False
                if row > 0:
                    if board[row-1][col].letter == board[row][col].letter:
                        return False
                if row < 4-1:
                    if board[row+1][col].letter == board[row][col].letter:
                        return False
                if col > 0:
                    if board[row][col-1].letter == board[row][col].letter:
                        return False
                if col < 4-1:
                    if board[row][col+1].letter == board[row][col].letter:
                        return False

    #if no empty cells and no possible merges game is over
    return True

def getHint(bestMove1, bestMove2): #stores best moves as text and returns
    if bestMove1 and bestMove2:
        hintText = f'{bestMove1} → {bestMove2}'
    elif bestMove1:
        hintText = f'{bestMove1}'
    else:
        hintText = "No moves found"
        
    return hintText


