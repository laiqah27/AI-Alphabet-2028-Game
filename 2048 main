def Game(): #game screen
    pygame.display.set_caption('Play Game')
    board = initializeBoard(tilecolours)
    #flags and variables initialised at the start og game
    key_pressed, movesQueue, score, gameOver, gameWon, hintText = False, [], 0, False, False, None
    
    while True:
        mousePosition = pygame.mouse.get_pos()
        screen.fill(BG)
        
