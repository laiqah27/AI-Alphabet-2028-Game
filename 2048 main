def displayScore(screen, score, x_pos=497, y_pos=33, button_width=165, button_height=40, font_size=30):
    #draw buttons
    scoreButton1 = pygame.draw.rect(screen, BROWN, pygame.Rect(x_pos, y_pos, button_width, button_height))
