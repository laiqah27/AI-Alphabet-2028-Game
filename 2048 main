def initializeBoard(tilecolours):
    board = [[None for _ in range(4)] for _ in range(4)]
    
    #randomly place two starting tiles
    for i in range(2):
        row = random.randint(0, 4 - 1)
        col = random.randint(0, 4 - 1)
        if board[row][col] is None:
            x = BOARDSTART_X + col * (TILE_SIZE + TILE_PADDING)
            y = BOARDSTART_Y + row * (TILE_SIZE + TILE_PADDING)
            board[row][col] = Tile('A', (x,y), TILE_SIZE, pygame.font.SysFont('clearsansbold.ttf', 72), tilecolours['dark text'], tilecolours)
                
    return board

def addRandomTile(board, tilecolours): #function to randomly place a tile after a move
    empty_positions = [] #list of empty tiles
    for row in range(4):
        for col in range(4):
            if board[row][col] is None:
                empty_positions.append((row, col))
    
    if len(empty_positions) > 0: #check if there are any empty spots
        row, col = random.choice(empty_positions) #select a random empty position
        x = BOARDSTART_X + col * (TILE_SIZE + TILE_PADDING) #calculate the x position for the new tile
        y = BOARDSTART_Y + row * (TILE_SIZE + TILE_PADDING) #calculate the y position for the new tile
        #place new tile at the selected position
        board[row][col] = Tile('A', (x, y), TILE_SIZE, pygame.font.SysFont('clearsansbold.ttf', 72), tilecolours['dark text'], tilecolours)
    
    return board

def drawPieces(screen, board): #draws tiles onto board randomly
    for i in range(len(board)):
        for j in range(len(board[i])):  
            tile = board[i][j]
            x = BOARDSTART_X + j * (TILE_SIZE + TILE_PADDING)
            y = BOARDSTART_Y + i * (TILE_SIZE + TILE_PADDING)
            if tile:
                tile.draw(screen)
            else:
                pygame.draw.rect(screen, tilecolours['empty'], [x, y, TILE_SIZE, TILE_SIZE], border_radius=10)

def getInputKey(event): #this will retrieve the move the user has entered
    if event.type == pygame.KEYDOWN:
        if event.key == K_LEFT:
            move = "left"
            return move
        elif event.key == K_RIGHT:
            move = "right"
            return move
        elif event.key == K_UP:
            move = "up"
            return move
        elif event.key == K_DOWN:
            move = "down"
            return move
    else:
        return None

def addMovetoQueue(move, movesQueue): #this adds moves to the moves queue
    if move in ['up', 'down', 'left', 'right']:
        movesQueue.append(move)

def moveTiles(movesQueue, board, score):
    successfulMove = False
    if len(movesQueue) >= 1:
        move = movesQueue.pop(0) #dequeues next move to be executed
        if move == 'up':
            successfulMove = moveUp(board, score)
        if move == 'down':
            successfulMove = moveDown(board, score)
        if move == 'left':
            successfulMove = moveLeft(board, score)
        if move == 'right':
            successfulMove = moveRight(board, score)

    return successfulMove
                                        
def moveUp(board, score):
    newTile = ''
    successfulMove = False
    for col in range(len(board)): #loops through each column
        temp = [board[row][col] for row in range(len(board)) if board[row][col] is not None] #temporary list of tiles on board

        for tile in temp:
           tile.hasMerged = False #tiles in temp list have not yet merged
            
        i = 0 #used to loop through temp list
        while i < len(temp) - 1:
            if temp[i].letter == temp[i + 1].letter and not temp[i].hasMerged and not temp[i + 1].hasMerged: #checks if tiles can merge
                newTile = temp[i].nextLetter(temp[i].letter)
                temp[i].hasMerged = True     #merge tiles
                temp.pop(i + 1) #remove the second tile
                successfulMove = True
                score = calculateScore(newTile, score)

            else:
                i += 1

        for row in range(len(board)):
            if row < len(temp):
                board[row][col] = temp[row]
                board[row][col].position = (BOARDSTART_X + col * (TILE_SIZE + TILE_PADDING),
                                            BOARDSTART_Y + row * (TILE_SIZE + TILE_PADDING)) # Fill with tiles from temp
            else:
                board[row][col] = None

    return successfulMove, newTile, score

def moveDown(board, score):
    newTile = ''
    successfulMove = False
    for col in range(len(board)): #loops through each column
        temp = [board[row][col] for row in range(len(board)) if board[row][col] is not None] #temporary list of tiles on board

        for tile in temp:
           tile.hasMerged = False #tiles in temp list have not yet merged
            
        i = len(temp) - 1 #used to loop through temp list
        while i > 0:
            if temp[i].letter == temp[i - 1].letter and not temp[i].hasMerged and not temp[i - 1].hasMerged: #checks if tiles can merge
                newTile = temp[i].nextLetter(temp[i].letter)
                temp[i].hasMerged = True     #merge tiles
                temp.pop(i - 1) #remove the second tile
                i -= 1
                successfulMove = True
                score = calculateScore(newTile, score)
            else:
                i -= 1

        for row in range(len(board) - 1, -1, -1, ):
            if len(temp) > 0:
                board[row][col] = temp.pop(-1)
                board[row][col].position = (BOARDSTART_X + col * (TILE_SIZE + TILE_PADDING),
                                            BOARDSTART_Y + row * (TILE_SIZE + TILE_PADDING)) # Fill with tiles from temp
            else:
                board[row][col] = None

    return successfulMove, newTile, score

