        displayboardBackground(board)
        drawPieces(screen, board)
        displayScore(screen, score)
        #draws hint button to screen
        hintButton = Button(shape = getButton(BROWN, 115, 45), pos = (170,220), textInput = 'AI Hint', font = getFont(30), baseColour = WHITE, hoveringColour = WHITE, hoverFontSizeIncrease = 0)
        hintButton.update(screen)

        if not gameOver and not gameWon:
            if hintText:
                screen.blit(getFont(30).render(hintText, True, BROWN), (250, 200))
            if movesQueue:
                successfulMove, newTile, score = moveTiles(movesQueue, board, score)
                addRandomTile(board, tilecolours)

        gameOver = isgameOver(board) #flag to check if game has been lost and update
        gameWon = isgameWon(board)   ##flag to check if game has been won and update

        if gameOver: #displays game over screen
            displayGameEndScreen()
            font = pygame.font.SysFont('clearsansbold.ttf', 115)
            screen.blit(font.render('Game Over!', True, BROWN), (124, 350))
            
        if gameWon: #displays game won screen
            displayGameEndScreen()
            font = pygame.font.SysFont('clearsansbold.ttf', 115)
            screen.blit(font.render('You Won!', True, BROWN), (170, 350))

        if gameWon or gameOver: #displays restart button
            restartButton = Button(shape=getButton(BLACK, 250, 70), pos=(350, 500), textInput="Restart", font=getFont(40), baseColour=WHITE, hoveringColour=WHITE, hoverFontSizeIncrease=0)
            restartButton.update(screen)

        for event in pygame.event.get(): #allows user to quit game
            if event.type == pygame.QUIT:
                pygame.quit()
                sys.exit()

            if not gameOver and not gameWon and event.type == pygame.MOUSEBUTTONDOWN:

                if hintButton.checkForInput(mousePosition): #if hint button selected
                    root_node = Node(board, score=0, move=None, depth = 0, parent=None) #define current board state as root node
                    bestMove1, bestMove2 = getBestTwoMoves(root_node) #return 2 best moves from MCTS algorithm
                    hintText = getHint(bestMove1, bestMove2) #store hint as text
                    screen.blit(getFont(30).render(hintText, True, BROWN), (250, 200)) #displays hint on screen

                if backfromPlay.checkForInput(mousePosition):
                    displayMenu() 

            #restart game logic when restart button clicked
            elif event.type == pygame.MOUSEBUTTONDOWN:
                if restartButton.checkForInput(mousePosition):
                    Game()
                    
            #controls moves entered by user being enqueued for execution
            if not gameOver and event.type == pygame.KEYDOWN:
                move = getInputKey(event) 
                if move:
                    addMovetoQueue(move, movesQueue)
                    
        pygame.display.update()

